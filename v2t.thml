// ==========================================
// 字典編譯與解析引擎 (Max Match Algorithm)
// ==========================================
const charToBpmfCache = {};
for (const [bpmf, chars] of Object.entries(BOPOMOFO_COMPRESSED_DICT)) {
    for (let i = 0; i < chars.length; i++) {
        const char = chars[i];
        if (!charToBpmfCache[char]) {
            charToBpmfCache[char] = bpmf;
        }
    }
}

function parseSentence(text) {
    let result = [];
    let i = 0;
    const maxPhraseLen = 6; 

    while (i < text.length) {
        let matched = false;
        for (let len = Math.min(maxPhraseLen, text.length - i); len >= 2; len--) {
            let word = text.slice(i, i + len);
            if (PHRASE_BPMF_DICT[word]) {
                let bpmfs = PHRASE_BPMF_DICT[word].split(',');
                for (let j = 0; j < len; j++) {
                    result.push({ char: word[j], bpmf: bpmfs[j] });
                }
                i += len;
                matched = true;
                break;
            }
        }
        if (!matched) {
            let char = text[i];
            result.push({ char: char, bpmf: charToBpmfCache[char] || "" });
            i++;
        }
    }
    return result;
}

// ==========================================
// 系統控制與渲染引擎 (完美回歸穩定版)
// ==========================================
const ControlSystem = (() => {
    let activeLineElement = document.getElementById('activeLine');
    let isUserLocked = true;
    let hasPermissionError = false; 
    let lastSpeechTime = Date.now();
    let timeoutTimer = null;
    let coolDownLock = false;
    let isMicRestarting = false;

    let finalTranscriptCache = '';
    let interimTranscriptCache = '';

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognition = null;

    if (SpeechRecognition) {
        recognition = new SpeechRecognition();
        recognition.lang = 'zh-TW';
        recognition.continuous = true;
        recognition.interimResults = true;

        recognition.onresult = (event) => {
            if (isUserLocked) return;

            lastSpeechTime = Date.now(); 
            let interim = '';
            let final = '';

            for (let i = event.resultIndex; i < event.results.length; ++i) {
                if (event.results[i] && event.results[i][0]) {
                    const transcriptPiece = event.results[i][0].transcript;
                    
                    if (typeof transcriptPiece === 'undefined' || transcriptPiece === null) {
                        continue;
                    }
                    
                    if (event.results[i].isFinal) {
                        final += transcriptPiece;
                    } else {
                        interim += transcriptPiece;
                    }
                }
            }

            if (final.length > 0) finalTranscriptCache += final;
            interimTranscriptCache = interim;
            
            renderPipeline(finalTranscriptCache || '', interimTranscriptCache || '');
        };

        recognition.onerror = (event) => {
            console.warn("語音辨識非致命性狀況:", event.error);
            
            if (event.error === 'no-speech') {
                return; 
            }

            if (event.error === 'not-allowed' || event.error === 'service-not-allowed' || event.error === 'audio-capture') {
                hasPermissionError = true;
                ControlSystem.lockSystem(); 
                document.getElementById('statusBanner').innerText = "⚠️ 麥克風未授權或設備受阻";
                document.getElementById('listenBtn').innerText = "⚠️ 需授權";
            }
        };

        recognition.onend = () => {
            if (isUserLocked || hasPermissionError) {
                isMicRestarting = false;
                return;
            }

            if (isMicRestarting) return;
            isMicRestarting = true;

            setTimeout(() => {
                try {
                    if (!isUserLocked && !hasPermissionError) {
                        recognition.start();
                        console.log("🔄 麥克風已安全自動重啟");
                    }
                } catch(e) {
                    console.warn("麥克風重啟併發衝突攔截:", e);
                } finally {
                    isMicRestarting = false;
                }
            }, 800);
        };
    }

    function renderPipeline(finalText, interimText) {
        if (!activeLineElement) return;
        const fragment = document.createDocumentFragment();
        processTokens(finalText, true, fragment);
        processTokens(interimText, false, fragment);
        activeLineElement.innerHTML = '';
        activeLineElement.appendChild(fragment);
        autoScalePipeline();
    }

    function processTokens(text, isFinal, fragmentParent) {
        if (!text || typeof text !== 'string' || text === "undefined") return;

        const tokens = text.match(/[\u4e00-\u9fa5]+|[a-zA-Z0-9_]+|[^a-zA-Z0-9_\u4e00-\u9fa5]+/g) || [];

        tokens.forEach(token => {
            if (!token || token === "undefined") return;

            if (/^[a-zA-Z0-9_]+$/.test(token)) {
                const charBox = document.createElement('div');
                charBox.className = `char-box is-english ${isFinal ? 'is-final' : 'is-interim'}`;
                charBox.innerHTML = `<div class="char-zh">${token}</div>`;
                fragmentParent.appendChild(charBox);
            } 
            else if (/^[\u4e00-\u9fa5]+$/.test(token)) {
                const parsedItems = parseSentence(token);
                parsedItems.forEach(item => {
                    const charBox = document.createElement('div');
                    charBox.className = `char-box ${isFinal ? 'is-final' : 'is-interim'}`;
                    const bpmfString = item.bpmf;

                    if (bpmfString) {
                        let bpmfSymbolsHtml = '';
                        let toneHtml = '';

                        if (bpmfString.endsWith('˙')) {
                            bpmfSymbolsHtml += `<span class="bpmf-tone-light">˙</span>`;
                            const mainTones = bpmfString.slice(0, -1);
                            for (let sym of mainTones) { bpmfSymbolsHtml += `<span>${sym}</span>`; }
                        } 
                        else if (/[ˊˇˋ]/.test(bpmfString)) {
                            const toneChar = bpmfString.match(/[ˊˇˋ]/)[0];
                            const mainTones = bpmfString.replace(/[ˊˇˋ]/, '');
                            for (let sym of mainTones) { bpmfSymbolsHtml += `<span>${sym}</span>`; }
                            toneHtml = `<span class="bpmf-tone">${toneChar}</span>`;
                        } 
                        else {
                            for (let sym of bpmfString) { bpmfSymbolsHtml += `<span>${sym}</span>`; }
                        }

                        charBox.innerHTML = `
                            <div class="char-zh">${item.char}</div>
                            <div class="char-bpmf-container">
                                <div class="bpmf-symbols">${bpmfSymbolsHtml}</div>
                                ${toneHtml}
                            </div>
                        `;
                    } else {
                        charBox.innerHTML = `<div class="char-zh">${item.char}</div>`;
                    }
                    fragmentParent.appendChild(charBox);
                });
            } 
            else {
                for(let i=0; i<token.length; i++) {
                    let p = token[i];
                    if(p.trim() === '') continue;
                    const charBox = document.createElement('div');
                    charBox.className = `char-box is-punctuation ${isFinal ? 'is-final' : 'is-interim'}`;
                    charBox.innerHTML = `<div class="char-zh">${p}</div>`;
                    fragmentParent.appendChild(charBox);
                }
            }
        });
    }

    function autoScalePipeline() {
        const container = document.getElementById('displayContainer');
        const wrapper = document.getElementById('wrapper');
        const boxes = container.querySelectorAll('.char-box:not(.is-english):not(.is-punctuation)');
        const englishBoxes = container.querySelectorAll('.char-box.is-english');

        let currentFontRem = 5.0; 
        setElementSizes(currentFontRem, boxes, englishBoxes);

        while (wrapper.offsetHeight > container.offsetHeight && currentFontRem > 2.2) {
            currentFontRem -= 0.2;
            setElementSizes(currentFontRem, boxes, englishBoxes);
        }
        container.scrollTop = container.scrollHeight; 
    }

    function setElementSizes(rem, boxes, englishBoxes) {
        boxes.forEach(box => {
            const zhNode = box.querySelector('.char-zh');
            if (zhNode) {
                zhNode.style.fontSize = `${rem}rem`;
                zhNode.style.width = `${rem}rem`;
                zhNode.style.height = `${rem}rem`;
            }
            const symbols = box.querySelector('.bpmf-symbols');
            if (symbols) {
                symbols.querySelectorAll('span:not(.bpmf-tone-light)').forEach(s => s.style.fontSize = `${rem * 0.26}rem`);
            }
            const lightTone = box.querySelector('.bpmf-tone-light');
            if (lightTone) lightTone.style.fontSize = `${rem * 0.28}rem`;
            
            const normalTone = box.querySelector('.bpmf-tone');
            if (normalTone) normalTone.style.fontSize = `${rem * 0.24}rem`;
        });
        englishBoxes.forEach(box => {
            const engNode = box.querySelector('.char-zh');
            if (engNode) {
                engNode.style.fontSize = `${rem * 0.7}rem`;
                engNode.style.height = `${rem}rem`;
                engNode.style.lineHeight = `${rem}rem`;
            }
        });
    }

    function startTimeoutChecker() {
        if (timeoutTimer) clearInterval(timeoutTimer);
        timeoutTimer = setInterval(() => {
            if (!isUserLocked && (Date.now() - lastSpeechTime > 3500) && activeLineElement.children.length > 0) {
                activeLineElement.removeAttribute('id');
                finalTranscriptCache = '';
                interimTranscriptCache = '';
                const newLine = document.createElement('div');
                newLine.className = 'speech-line';
                newLine.id = 'activeLine';
                document.getElementById('wrapper').appendChild(newLine);
                activeLineElement = newLine;
                lastSpeechTime = Date.now();
            }
        }, 1000);
    }

    return {
        startListen: () => {
            if (!SpeechRecognition || coolDownLock) {
                if(!SpeechRecognition) alert("此瀏覽器不支援 Web Speech API，推薦在 Chrome 或 Edge 中開啟。");
                return;
            }
            coolDownLock = true;
            setTimeout(() => coolDownLock = false, 300);

            hasPermissionError = false; 

            if (isUserLocked) {
                isUserLocked = false;
                document.body.className = "state-listening";
                document.getElementById('statusBanner').innerText = "🎙️ 系統狀態：正在即時聆聽並翻譯注音...";
                document.getElementById('listenBtn').innerText = "🛑 停止轉錄";
                document.getElementById('lockBtn').innerText = "🔒 鎖定定型";

                lastSpeechTime = Date.now();
                startTimeoutChecker();
                
                isMicRestarting = false; 
                try { recognition.start(); } catch(e) { console.log(e); }
            } else {
                ControlSystem.lockSystem();
            }
        },

        lockSystem: () => {
            if (coolDownLock) return;
            coolDownLock = true;
            setTimeout(() => coolDownLock = false, 300);

            isUserLocked = true;
            document.body.className = "state-locked";
            document.getElementById('statusBanner').innerText = "🔒 系統狀態：魔法定型中（唯讀）";
            document.getElementById('listenBtn').innerText = "🟢 開始轉錄";

            if (timeoutTimer) clearInterval(timeoutTimer);
            
            isMicRestarting = false; 
            try { recognition.stop(); } catch(e) { console.log(e); }
        },

        clearSystem: () => {
            if (coolDownLock) return;
            coolDownLock = true;
            setTimeout(() => coolDownLock = false, 300);

            if (timeoutTimer) clearInterval(timeoutTimer);

            document.getElementById('wrapper').innerHTML = '<div class="speech-line" id="activeLine"></div>';
            activeLineElement = document.getElementById('activeLine');

            finalTranscriptCache = '';
            interimTranscriptCache = '';

            if (!isUserLocked) {
                lastSpeechTime = Date.now();
                startTimeoutChecker();
                try { recognition.abort(); } catch(e) { console.log(e); }
            } else {
                autoScalePipeline(); 
            }
        },

        triggerResizeScale: () => {
            autoScalePipeline();
        }
    };
})();

(() => {
    let resizeTimeout = null;
    window.addEventListener('resize', () => {
        if (resizeTimeout) clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => { ControlSystem.triggerResizeScale(); }, 150);
    });
    window.addEventListener('orientationchange', () => {
        setTimeout(() => ControlSystem.triggerResizeScale(), 300);
    });
})();
</script>
</body>
</html>
